# g9s-devbox — operator inputs for the local compose flow (P1).
#
# Copy to `.env` next to `deploy/compose.yml` usage and fill real values.
# `.env` is gitignored; real values never enter VCS.
#
# Every key below is required: compose substitutes each one as ${KEY:?...},
# so a missing or empty value fails `docker compose config/up` loudly
# instead of starting on defaults. Values agreed for the first P1 node are
# shown; CPU/memory/PIDs are per-node upper bounds, not reservations —
# recalculate them for a new node before `up`.

# Host directory mounted as /var/lib/devbox. Must be prepared by
# scripts/host-prep.sh first; compose never creates it (create_host_path:
# false).
DEVBOX_HOST_PATH=/var/lib/devbox

# Numeric UID/GID of the unprivileged `dev` user. Fixed by the root-owned
# identity marker on first boot; changing them later is an explicit
# migration, not an env edit.
DEVBOX_UID=1000
DEVBOX_GID=1000

# OpenSSH public keys allowed to log in as `dev` — the only login
# trust-channel. One key per line inside single quotes; no `#` comment lines
# (put descriptions in the key comment field instead). Private keys are NOT
# copied anywhere. Rotation = edit + recreate (`up -d --force-recreate`;
# plain `restart` does NOT re-read this file — see
# docs/runbooks/p1-local-core.md §6).
DEVBOX_AUTHORIZED_KEYS='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleMacBookPublicKeyPlaceholder p1-macbook
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleSecondKeyPlaceholder p1-minipc'

# Published SSH endpoint: host address and host port -> container 22.
# BIND is the address clients reach (LAN/VPN); binding 0.0.0.0 publishes on
# every address — choose deliberately.
DEVBOX_SSH_BIND=10.0.0.100
DEVBOX_SSH_PORT=2222

# Resource limits for this node (upper bounds, no reservation; swap is not
# workload memory). Per-node: re-measure before reuse on another host.
DEVBOX_CPU_LIMIT=6.0
DEVBOX_MEMORY_LIMIT=6656m
DEVBOX_PIDS_LIMIT=1024
